# =============================================================================
# Shopify Admin API — credentials (grant client_credentials)
# -----------------------------------------------------------------------------
# Copiez ce fichier en `.env` et remplissez les VRAIES valeurs.
# Le fichier `.env` ne doit JAMAIS être commité (déjà dans .gitignore).
# Aucune valeur réelle ne doit apparaître dans le code ou un fichier versionné.
# =============================================================================

# Domaine .myshopify.com de la boutique (sans https://, sans slash final)
# Exemple : paul-beuscher-2.myshopify.com
SHOPIFY_SHOP=your-store.myshopify.com

# Identifiants de l'app personnalisée / custom app
SHOPIFY_CLIENT_ID=your_client_id_here
SHOPIFY_CLIENT_SECRET=your_client_secret_here
